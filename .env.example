# Copiez ce fichier en .env et remplissez les valeurs.

# Clé API Claude (server-side uniquement — jamais exposée au client)
ANTHROPIC_API_KEY=

# Secret partagé backend <-> IA (authentification service-à-service).
# Générez-le avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-generate-a-strong-secret

AI_ENV=development

# --- Choix du fournisseur LLM (optionnel) ----------------------------------
# Par defaut : Anthropic / Claude (CDCF §5.1). Pour en changer, il n'y a AUCUN
# code a modifier : ces variables suffisent.
#
#   LLM_PROVIDER=openai_compatible
#
# Exemples d'URL de base :
#   Mistral      https://api.mistral.ai/v1          (europeen, bon en francais)
#   OpenAI       https://api.openai.com/v1
#   Groq         https://api.groq.com/openai/v1     (tres rapide, palier gratuit)
#   OpenRouter   https://openrouter.ai/api/v1       (acces a des dizaines de modeles)
#   Ollama       http://localhost:11434/v1          (local, aucune cle, gratuit)
#
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL_FAST=
# LLM_MODEL_REASONING=
#
# Prix $/1M tokens a appliquer si le modele n'est pas au catalogue interne.
# IMPORTANT : sans ces valeurs, un modele inconnu coute 0 et le plafond de cout
# ne se declenche JAMAIS.
# LLM_PRIX_ENTREE=
# LLM_PRIX_SORTIE=
DEFAULT_MAX_TOKENS=1024
# Plafond de coût cumulé par workspace en $ (0 = illimité). Protège la facture LLM.
MAX_COST_PER_WORKSPACE=0

# --- Sources de prospection (optionnelles) ---------------------------------
# Sans ces cles, le sourcing fonctionne en mode simulation (dry_run) : il montre
# les requetes qui seraient envoyees, sans appeler les API ni facturer.
APOLLO_API_KEY=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
